{
  "name": "miuku-ui",
  "type": "module",
  "version": "0.0.4",
  "description": "A Vue component library.",
  "author": {
    "name": "VisionView",
    "email": "1275919414@qq.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/miukuit/miuku-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miukuit/miuku-ui.git"
  },
  "bugs": {
    "url": "https://github.com/miukuit/miuku-ui/issues"
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.cjs",
  "unpkg": "./dist/index.umd.cjss",
  "jsdelivr": "./dist/index.umd.cjss",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "konva": "^10.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^24.12.3",
    "@unocss/eslint-plugin": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.0.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.2",
    "unocss": "^66.6.8",
    "unplugin-dts": "^1.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json}": [
      "pnpm lint:fix"
    ]
  }
}
